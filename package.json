{
  "name": "rulebase-skills",
  "version": "0.1.0",
  "description": "CX ops and customer support agent skills for Claude Code, Codex and Cursor. Install with npx rulebase-skills install <slug>.",
  "type": "module",
  "license": "MIT",
  "author": "Rulebase",
  "homepage": "https://github.com/rulebase-co/rulebase-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulebase-co/rulebase-skills.git"
  },
  "bugs": {
    "url": "https://github.com/rulebase-co/rulebase-skills/issues"
  },
  "bin": {
    "rulebase-skills": "./bin/rulebase-skills.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-skills",
    "agent-skills",
    "skills",
    "codex",
    "cursor",
    "cx",
    "cx-ops",
    "customer-support",
    "customer-service",
    "quality-assurance",
    "contact-center"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "validate:strict": "node scripts/validate-skills.mjs --strict",
    "build:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run validate:strict && npm run check:index && npm test"
  }
}
